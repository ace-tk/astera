# Astera API environment
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/astera

# Auth
JWT_SECRET=replace-with-a-long-random-string
