# Integrations (placeholders — the demo pipeline runs without them)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
