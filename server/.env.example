# Astera API environment
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/astera

# Auth — in production JWT_SECRET must be ≥32 chars and not the default,
# or the server refuses to boot. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Integrations (placeholders — the demo pipeline runs without them)
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
