# Astera API environment
NODE_ENV=development
PORT=5050
# Comma-separated allowlist of frontend origins (CORS + Socket.io). No wildcards.
# e.g. CLIENT_URL=https://your-app.vercel.app,https://test1.atoopv.com
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas SRV string in production)
MONGODB_URI=mongodb://127.0.0.1:27017/astera

# Auth — in production JWT_SECRET must be >=32 chars and not the default,
# or the server refuses to boot. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Admin panel access — comma-separated allowlist of admin emails.
# (A user whose role is 'admin' is also an admin.) Leave blank for no admins.
ADMIN_EMAILS=

# Speech-to-text for uploaded audio/video (MP3/MP4/WAV/M4A). Get a free key at
# https://console.deepgram.com (Settings -> API Keys). Without it, audio uploads
# return a friendly "not configured" message; TXT/DOCX/PDF still work.
DEEPGRAM_API_KEY=

# Optional — unused by the shipped heuristic analysis; leave blank.
OPENAI_API_KEY=

# Email delivery (verification / invitation / password-reset emails) via
# Resend (https://resend.com). Without a key, emails are logged to the server
# console instead of sent — signup and admin actions still work either way.
RESEND_API_KEY=
MAIL_FROM=Astera <onboarding@resend.dev>

# Deepgram transcription timeout (ms). Must stay under the hosting platform's
# function timeout. Default (170000) restores close to the original 180s
# allowance while leaving headroom under Vercel Hobby's 300s hard cap (with
# Fluid Compute). On Vercel Pro, raise this further and update vercel.json's
# functions["api/**/*.js"].maxDuration to match.
TRANSCRIPTION_TIMEOUT_MS=170000

# Redis, used ONLY for Socket.IO's cross-instance pub/sub (never application
# data — MongoDB Atlas remains the source of truth for everything else).
# Required in production so report:stage/report:ready events reliably reach a
# client whose WebSocket landed on a different Vercel function instance than
# the one processing the upload. Optional in development — falls back to
# same-instance-only delivery, which is fine for a single local process.
# e.g. REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_URL=
