{
  "name": "astera-server",
  "version": "0.1.0",
  "description": "Astera API — turns meeting recordings into intelligence reports.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "seed:test-accounts": "node src/seedTestAccounts.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "cms:backup": "node src/cms/migrate/backup.js backup",
    "cms:restore": "node src/cms/migrate/backup.js restore",
    "cms:import": "node src/cms/migrate/importServiceArticles.js",
    "cms:legacy-slugs": "node src/cms/migrate/generateLegacySlugs.js",
    "cms:import-nav": "node src/cms/migrate/importNavigation.js",
    "cms:fixed-menus": "node src/cms/migrate/generateFixedMenus.js",
    "e2e:stack": "node scripts/e2e-stack.mjs"
  },
  "dependencies": {
    "@deepgram/sdk": "^5.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "mongoose": "^8.7.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5",
    "redis": "^4.7.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.18.1",
    "socket.io": "^4.8.0",
    "unified": "^11.0.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^3.2.7"
  }
}
