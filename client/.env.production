# Production build settings (loaded automatically by `vite build`). No secrets belong here:
# everything in a VITE_* variable is baked into the public JavaScript bundle.
#
# Same-origin API: the browser calls https://<your-domain>/api/... — the same host serves the
# site and the API, so no CORS, no absolute URLs, no Vercel/test1 hostnames.
VITE_API_URL=/api
VITE_DEMO_MODE=false
# Leave VITE_SOCKET_URL unset: an unset value means "connect same-origin" (path /api/socket.io).
