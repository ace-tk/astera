# Production build settings (loaded automatically by `vite build`). No secrets belong here:
# everything in a VITE_* variable is baked into the public JavaScript bundle.
#
# The API is on its own subdomain (api.atoopv.com) — O2Switch's sub-path Node app
# (atoopv.com/api) didn't hook up to Passenger, so the backend now runs on this
# dedicated subdomain instead (see deploy/o2switch/README.md's "Sub-path app" row).
# CLIENT_URL on the server already covers CORS for this origin — no server code change.
VITE_API_URL=https://api.atoopv.com/api
VITE_SOCKET_URL=https://api.atoopv.com
VITE_DEMO_MODE=false
# Socket.IO's own path (client/src/config/index.js's socketPath) is still the
# fixed '/api/socket.io' — combined with VITE_SOCKET_URL above, the client
# connects to https://api.atoopv.com/api/socket.io, matching the server's
# same-path SOCKET_PATH (server/src/services/socket.js).
