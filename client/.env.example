# Astera client environment
# Demo mode renders the full product from local seeded data (no backend needed).
VITE_DEMO_MODE=true

# Point these at the deployed API to use the live backend.
# Local dev (separate backend process on :5050):
VITE_API_URL=http://localhost:5050/api
VITE_SOCKET_URL=http://localhost:5050
# Production, frontend + backend on the same Vercel domain (e.g. test1.atoopv.com):
#   VITE_API_URL=/api
#   VITE_SOCKET_URL unset — an unset value means "connect same-origin", which
#   is correct when the frontend and backend share a domain. The socket path
#   itself (/api/socket.io) is fixed in client/src/config/index.js, not env-driven.
