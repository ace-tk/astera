{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --prefix client --include=dev && npm install --prefix server",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/dist",
  "fluid": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/simulateur",
      "destination": "/tarification",
      "permanent": true
    },
    {
      "source": "/atoopv/simulateur",
      "destination": "/tarification",
      "permanent": true
    },
    {
      "source": "/atoopv",
      "destination": "/accueil",
      "permanent": true
    },
    {
      "source": "/atoopv/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
