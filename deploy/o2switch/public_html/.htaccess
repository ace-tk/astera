# ─────────────────────────────────────────────────────────────────────────────
# ATOOPV — .htaccess   (React single-page app; API lives on api.atoopv.com)
#
# GENERATED by client/scripts/seo/htaccess.mjs from scripts/seo/redirectMap.mjs.
# Do not edit by hand — change the map / generator and run `npm run seo:htaccess`.
#
# mode: base (redirects + 410s + SPA fallback)
#
# If cPanel ever adds its own Passenger block here ("# DO NOT REMOVE. CLOUDLINUX PASSENGER
# CONFIGURATION") KEEP it and add the rules around it — never inside it.
# ─────────────────────────────────────────────────────────────────────────────

DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. The API (incl. /api/socket.io) is never rewritten.
  RewriteRule ^api(/|$) - [L]

  # 1. Discontinued content and WordPress leftovers → HTTP 410 Gone (not a redirect to the
  #    homepage: Google treats mass-redirects of dead pages to "/" as soft 404s).
  RewriteRule ^(podcast-videos|faq|plan-du-site)/?$ - [G,NC,L]
  RewriteRule ^(author|wp-content|wp-json|wp-admin|wp-includes)/ - [G,NC,L]
  RewriteRule (^|/)feed/?$ - [G,L]
  RewriteRule ^(wp-[^/]*\.php|xmlrpc\.php)$ - [G,L]

  # 2. Legacy URL → final URL, ONE hop, with or without trailing slash (query string kept).
  #    Placed before the www/https canonicalisation so even http://www… reaches the target in
  #    a single 301.
  RewriteRule ^redaction-pv-cse/?$ https://atoopv.com/services/drafting/redaction-pv-cse [R=301,L]
  RewriteRule ^redaction-du-pv/?$ https://atoopv.com/services/drafting/redaction-pv-cse [R=301,L]
  # interim — brief 2.5
  RewriteRule ^audiotypie-pv-cse/?$ https://atoopv.com/services/drafting/redaction-pv-cse [R=301,L]
  RewriteRule ^nos-services-pv/?$ https://atoopv.com/services/drafting [R=301,L]
  RewriteRule ^redaction-pv-cssct/?$ https://atoopv.com/services/drafting/redaction-pv-cssct [R=301,L]
  RewriteRule ^externaliser-pv-cse/?$ https://atoopv.com/services/drafting/externaliser-pv-cse [R=301,L]
  RewriteRule ^redaction-pv-csec/?$ https://atoopv.com/services/drafting/redaction-pv-csec [R=301,L]
  RewriteRule ^redaction-pv-irp/?$ https://atoopv.com/services/drafting/redaction-pv-irp [R=301,L]
  RewriteRule ^redaction-pv-cse-a-lacte/?$ https://atoopv.com/services/drafting/redaction-pv-cse-a-lacte [R=301,L]
  RewriteRule ^redaction-a-lacte/?$ https://atoopv.com/services/drafting/redaction-pv-cse-a-lacte [R=301,L]
  RewriteRule ^tarif-redaction-pv-cse/?$ https://atoopv.com/tarification [R=301,L]
  RewriteRule ^(simulateur|simulateur-de-prix)/?$ https://atoopv.com/tarification [R=301,L]
