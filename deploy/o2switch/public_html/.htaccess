  RewriteRule ^redaction-pv-cse-toulouse/?$ https://atoopv.com/services/by-city/redaction-pv-cse-toulouse [R=301,L]
  RewriteRule ^redaction-pv-de-cse-a-marseille/?$ https://atoopv.com/services/by-city/redaction-pv-cse-marseille [R=301,L]
