  RewriteRule ^redaction-pv-cse-annecy/?$ https://atoopv.com/services/by-city/redaction-pv-cse-annecy [R=301,L]
  RewriteRule ^redaction-pv-cse-bordeaux/?$ https://atoopv.com/services/by-city/redaction-pv-cse-bordeaux [R=301,L]
  RewriteRule ^redaction-pv-cse-clermont-ferrand/?$ https://atoopv.com/services/by-city/redaction-pv-cse-clermont-ferrand [R=301,L]
  RewriteRule ^redaction-pv-cse-grenoble/?$ https://atoopv.com/services/by-city/redaction-pv-cse-grenoble [R=301,L]
  RewriteRule ^redaction-pv-cse-lille/?$ https://atoopv.com/services/by-city/redaction-pv-cse-lille [R=301,L]
