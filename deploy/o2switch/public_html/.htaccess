  RewriteRule ^canicule-travail-decret-2025-482-obligations-employeur-cse/?$ https://atoopv.com/ressources/canicule-travail-decret-2025-482-obligations-employeur-cse [R=301,L]
  RewriteRule ^histoire-cse-comite-entreprise-cnr-1943/?$ https://atoopv.com/ressources/histoire-cse-comite-entreprise-cnr-1943 [R=301,L]
  RewriteRule ^reorganisation-silencieuse-cse-demissions/?$ https://atoopv.com/ressources/reorganisation-silencieuse-cse-demissions [R=301,L]
  RewriteRule ^compteur-cp-arret-maladie-verifications-avant-solder/?$ https://atoopv.com/ressources/compteur-cp-arret-maladie-verifications-avant-solder [R=301,L]
  RewriteRule ^grossesse-licenciement-nul-protection-salariee-cour-cassation-2026/?$ https://atoopv.com/ressources/grossesse-licenciement-nul-protection-salariee-cour-cassation-2026 [R=301,L]
  RewriteRule ^guides-livres-blancs-cse/?$ https://atoopv.com/ressources/guides-livres-blancs-cse [R=301,L]
  RewriteRule ^teletravail-impose-cse-droits-employeur/?$ https://atoopv.com/ressources/teletravail-impose-cse-droits-employeur [R=301,L]
  RewriteRule ^harcelement-moral-methodes-gestion-cse/?$ https://atoopv.com/ressources/harcelement-moral-methodes-gestion-cse [R=301,L]
  RewriteRule ^commissaire-de-justice-cse-constat-entrave/?$ https://atoopv.com/ressources/commissaire-de-justice-cse-constat-entrave [R=301,L]
  RewriteRule ^reglement-interieur-fin-depot-greffe/?$ https://atoopv.com/ressources/reglement-interieur-fin-depot-greffe-mai-2026-loi-simplification [R=301,L]
  RewriteRule ^canicule-travail-decret-2025-482/?$ https://atoopv.com/ressources/canicule-travail-decret-2025-482-obligations-employeur-cse [R=301,L]
  RewriteRule ^mise-a-pied-elu-cse/?$ https://atoopv.com/ressources/mise-a-pied-conservatoire-elu-cse [R=301,L]
  # interim — brief 2.5
  RewriteRule ^absenteisme-cse-droit-exiger/?$ https://atoopv.com/ressources/actualite-sociale [R=301,L]
  # interim — brief 2.5
  RewriteRule ^le-controle-urssaf-sur-les-comptes-du-cse/?$ https://atoopv.com/ressources/actualite-sociale [R=301,L]
  RewriteRule ^actualites/?$ https://atoopv.com/ressources/actualite-sociale [R=301,L]
  RewriteRule ^autodiagnostic-cse/?$ https://atoopv.com/autodiagnostic [R=301,L]
  RewriteRule ^livres-blancs/?$ https://atoopv.com/ressources/guides-livres-blancs-cse [R=301,L]
  # duplicate of /services (brief 2.6)
  RewriteRule ^services/drafting/services/?$ https://atoopv.com/services [R=301,L]
  RewriteRule ^accueil/?$ https://atoopv.com/ [R=301,L]

  # 2b. Prefix redirects (WordPress taxonomy archives).
  RewriteRule ^category/veille-juridique-cse/?$ https://atoopv.com/ressources/veille-juridique-cse [R=301,L]
  RewriteRule ^category/ https://atoopv.com/ressources/actualite-sociale [R=301,L]
  RewriteRule ^tag/ https://atoopv.com/ressources/actualite-sociale [R=301,L]

  # 2c. Renamed routes of this site: /atoopv and /atoopv/* moved to the top level.
  RewriteRule ^atoopv/?$ https://atoopv.com/ [R=301,L]
  RewriteRule ^atoopv/simulateur/?$ https://atoopv.com/tarification [R=301,L]
  RewriteRule ^atoopv/(.+?)/?$ https://atoopv.com/$1 [R=301,L]

  # 3. www → apex, always over HTTPS (one redirect, not two).
  RewriteCond %{HTTP_HOST} ^www\.atoopv\.com$ [NC]
  RewriteRule ^ https://atoopv.com%{REQUEST_URI} [L,R=301]

  # 4. Enforce HTTPS (also honours a TLS-terminating proxy that sets X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 5. Trailing slash: any other URL ending in "/" → same URL without it (never the root,
  #    never a real directory such as /assets/).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ https://atoopv.com/$1 [R=301,L]

  # 6. Single-page-app fallback: real files/directories are served as-is; every other URL
  #    is handed to React Router.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The HTML shells must never be cached, otherwise visitors keep an old build after a deploy.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
