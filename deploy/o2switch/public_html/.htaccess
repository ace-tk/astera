# ─────────────────────────────────────────────────────────────────────────────
# ATOOPV — public_html/.htaccess   (React single-page app + Node API under /api)
#
# IMPORTANT: cPanel's "Setup Node.js App" writes its OWN Passenger block into this file
# (between "# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN" and "... END").
# If cPanel already created that block, KEEP it and add the rules below above or below it —
# never inside it, and never delete it, or /api stops working.
# ─────────────────────────────────────────────────────────────────────────────

DirectoryIndex index.html
Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. www -> apex, always over HTTPS (one redirect, not two).
  RewriteCond %{HTTP_HOST} ^www\.atoopv\.com$ [NC]
  RewriteRule ^ https://atoopv.com%{REQUEST_URI} [L,R=301]

  # 2. Enforce HTTPS (also honours a TLS-terminating proxy that sets X-Forwarded-Proto).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 3. The API (including /api/socket.io) belongs to the Node app. Leave it completely
  #    untouched so it is never rewritten to index.html.
  RewriteRule ^api(/|$) - [L]

  # 3b. SEO audit: /simulateur is a duplicate of /tarification and must not stay
  #     indexable — a real, permanent redirect (not the SPA's client-side one, which
  #     a crawler never gets a 301 status from, only a 200 + JS navigation).
  RewriteRule ^simulateur/?$ https://atoopv.com/tarification [R=301,L]
  RewriteRule ^atoopv/simulateur/?$ https://atoopv.com/tarification [R=301,L]

  # 3c. Route rename: /atoopv (and every /atoopv/* sub-path) moved to a top-level
  #     path — same pages, same content, only the URL changed (see App.jsx). Real
  #     server-level 301s for old bookmarks/search results/inbound links, same
  #     reasoning as 3b: a crawler needs an actual 301, not the SPA's client-side
  #     redirect. The bare "/atoopv" case is listed before the general "/atoopv/*"
  #     rule so it isn't swallowed by it.
  RewriteRule ^atoopv/?$ https://atoopv.com/accueil [R=301,L]
  RewriteRule ^atoopv/(.*)$ https://atoopv.com/$1 [R=301,L]

  # 4. Single-page-app fallback: real files/directories are served as-is; every other
  #    URL (e.g. /tarification, /app/admin) is handed to React Router.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # The HTML shell must never be cached, otherwise visitors keep an old build after a deploy.
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
