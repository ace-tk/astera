  RewriteRule ^surveillance-salaries-cnil-cse/?$ https://atoopv.com/ressources/surveillance-salaries-cnil-cse [R=301,L]
  RewriteRule ^heures-supplementaires-annualisation-arret-maladie-calcul-cour-cassation/?$ https://atoopv.com/ressources/heures-supplementaires-annualisation-arret-maladie-calcul-cour-cassation [R=301,L]
  RewriteRule ^mise-a-pied-conservatoire-elu-cse/?$ https://atoopv.com/ressources/mise-a-pied-conservatoire-elu-cse [R=301,L]
  RewriteRule ^cas-pratiques/?$ https://atoopv.com/ressources/cas-pratiques [R=301,L]
  RewriteRule ^la-minute-cse/?$ https://atoopv.com/ressources/la-minute-cse [R=301,L]
  RewriteRule ^comment-lire-arret-cour-de-cassation/?$ https://atoopv.com/ressources/comment-lire-arret-cour-de-cassation [R=301,L]
  RewriteRule ^actualite-sociale/?$ https://atoopv.com/ressources/actualite-sociale [R=301,L]
  RewriteRule ^proces-verbal/?$ https://atoopv.com/ressources/proces-verbal [R=301,L]
  RewriteRule ^droits-elus-cse-guide-juridique/?$ https://atoopv.com/ressources/droits-elus-cse-guide-juridique [R=301,L]
  RewriteRule ^conge-paye-vendredi-37h-decompte-jours-ouvrables/?$ https://atoopv.com/ressources/conge-paye-vendredi-37h-decompte-jours-ouvrables [R=301,L]
  RewriteRule ^signature-du-proces-verbal-de-reunion-du-cse/?$ https://atoopv.com/ressources/signature-du-proces-verbal-de-reunion-du-cse [R=301,L]
