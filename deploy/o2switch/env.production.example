# ─────────────────────────────────────────────────────────────────────────────
# ATOOPV — production environment for the O2Switch Node.js app
#
# Enter each of these in cPanel > Setup Node.js App > (your app) > "Environment variables".
# THIS FILE CONTAINS PLACEHOLDERS ONLY. Never commit real values, never put them in the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
# Do NOT set PORT — Passenger binds the app to its own socket.

# Comma-separated allowlist of the site's origins (CORS + Socket.IO). The FIRST entry is also the
# base of the links in emails (verify-email, invitations), so it must be the canonical public URL.
# For a staging test, temporarily append the staging origin, e.g. ...,https://staging.atoopv.com
CLIENT_URL=https://atoopv.com,https://www.atoopv.com

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas SRV string (same cluster/database the current Vercel deployment uses).
MONGODB_URI=CHANGE_ME_mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/astera?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# >= 32 characters, random. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start in production without a strong value.
JWT_SECRET=CHANGE_ME_at_least_32_random_characters
JWT_EXPIRES_IN=7d
# Comma-separated emails that get the admin/director role (a user with role=admin in the DB is also admin).
ADMIN_EMAILS=CHANGE_ME_admin@atoopv.com

# ── Speech-to-text (audio/video uploads) ─────────────────────────────────────
DEEPGRAM_API_KEY=CHANGE_ME_or_leave_empty_(TXT/DOCX/PDF_still_work)
# Must stay below the host's request timeout. 170000 = 170 s.
TRANSCRIPTION_TIMEOUT_MS=170000

# ── Email (Contact form, signup verification, admin invitations, password resets) ──
# Production on O2Switch: send through the cPanel mailbox over SMTP. No third-party service needed.
MAIL_PROVIDER=smtp
# Use the mail server hostname shown in cPanel > Email Accounts > "Connect Devices" >
# "Mail Client Manual Settings" (its TLS certificate matches that name).
SMTP_HOST=CHANGE_ME_mail_server_hostname
SMTP_PORT=465
SMTP_SECURE=true
# The full mailbox address created in cPanel and its password.
SMTP_USER=CHANGE_ME_no-reply@atoopv.com
SMTP_PASS=CHANGE_ME
# The From header. Must be an address on atoopv.com that SMTP_USER is allowed to send as.
MAIL_FROM=ATOOPV <no-reply@atoopv.com>
# Where the public Contact form delivers. (Defaults to contact@atoopv.com if omitted.)
CONTACT_TO_EMAIL=contact@atoopv.com
# Only if O2Switch's certificate does not match SMTP_HOST (avoid if possible): SMTP_TLS_REJECT_UNAUTHORIZED=false

# ── Tuning (optional — defaults are fine; see deploy/o2switch/README.md §6) ──
# Contact-form submissions allowed per visitor IP per 15 minutes.
# CONTACT_RATE_LIMIT_MAX=5
# Reverse-proxy hops in front of Node, used to find the real visitor IP. Default 1.
# TRUST_PROXY=1

# ── Not needed on O2Switch — leave UNSET ─────────────────────────────────────
# RESEND_API_KEY   (only if you choose MAIL_PROVIDER=resend instead of SMTP)
# REDIS_URL        (Socket.IO cross-instance pub/sub — only needed with several server instances)
# OPENAI_API_KEY   (unused)
